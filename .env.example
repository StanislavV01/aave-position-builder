# DRPC API key (required by the server). Get one at https://drpc.org.
# NEVER commit a real key. The key never reaches the browser.
DRPC_KEY=

# Server port (optional, default 8787)
PORT=8787

# Upstream RPC bases (optional — these defaults are correct)
DRPC_HTTP_BASE=https://lb.drpc.live
DRPC_WSS_BASE=wss://lb.drpc.live
